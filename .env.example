# ============================================
# AIRSTAY PROPERTIES — ENVIRONMENT VARIABLES
# ============================================
# SECURITY: never put secret keys in variables that start with VITE_ .
# Vite copies every VITE_ variable used by the code into the public website
# bundle, where anyone can read it. Secrets belong only in server-side
# variables used by files in /api.

# --- EMAIL (server-side, used by /api/lead) ---
# Added automatically by the "Resend for Vercel" integration.
RESEND_API_KEY=
# Optional overrides
LEAD_TO=info@airstayproperties.com
LEAD_FROM=
